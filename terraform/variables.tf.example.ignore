variable "cloudflare_token" {
  type        = string
  nullable    = false
  sensitive   = true
  description = "Cloudflare API Token."
}

variable "cloudflare_zone_id" {
  type        = string
  nullable    = false
  description = "Cloudflare zone ID."
}

variable "cloudflare_subdomain" {
  type        = string
  nullable    = false
  description = "Cloudflare subdomain for the RKE2 cluster (e.g. rke2.example.com)."
}
