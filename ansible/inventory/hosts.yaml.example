---
k8s_nodes:
  children:
    k8s_master_nodes:
    k8s_worker_nodes:

  vars:
    ssh_default_user: root
    ssh_user: non_root_superuser
    ssh_public_key: "ssh-ed25519 AAAA..."
    ssh_source_cidrs:
      - "0.0.0.0/0" # For testing only, remove this in production

    k8s_bootstrap_token: "very_secure_random_string"
    k8s_agent_token: "optional_secure_random_string"
    etcd_s3_bucket: ""
    etcd_s3_region: "ap-southeast-1"
    etcd_s3_access_key: "AKIA..."
    etcd_s3_secret_key: ""

    wireguard_extra_peers:
      - name: user01
        public_key: "<generated by `wg pubkey`>"
        allowed_ips: 10.0.0.100/32
      - name: user02
        public_key: "<generated by `wg pubkey`>"
        allowed_ips: 10.0.0.101/32

k8s_new_nodes:
  # TODO: Change this after initializing the cluster
  children:
    k8s_master_nodes:
    k8s_worker_nodes:

k8s_master_nodes:
  hosts:
    k8s-master-01:
      public_ip: <PUBLIC_IP>
      wireguard_ip: 10.0.0.1
    k8s-master-02:
      public_ip: <PUBLIC_IP>
      wireguard_ip: 10.0.0.2
    k8s-master-03:
      public_ip: <PUBLIC_IP>
      wireguard_ip: 10.0.0.3

k8s_worker_nodes:
  hosts:
    k8s-worker-01:
      public_ip: <PUBLIC_IP>
      wireguard_ip: 10.0.0.11
    k8s-worker-02:
      public_ip: <PUBLIC_IP>
      wireguard_ip: 10.0.0.12
    k8s-worker-03:
      public_ip: <PUBLIC_IP>
      wireguard_ip: 10.0.0.13
