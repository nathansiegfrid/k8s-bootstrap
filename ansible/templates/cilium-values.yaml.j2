# Override the destination namespace for Cilium resources.
namespaceOverride: "{{ cilium_namespace }}"

# Enable kube-proxy replacement mode.
# Required because kube-proxy is not deployed on this cluster.
kubeProxyReplacement: true
k8sServiceHost: localhost
k8sServicePort: "6443"

# Cilium Operator must run on control-plane nodes to reach localhost:6443.
operator:
  nodeSelector:
    node-role.kubernetes.io/control-plane: "true"

# Delegate pod IP allocation to Kubernetes.
# Pod subnets are assigned by the Kubernetes API server instead of Cilium.
# Prevents Cilium's default 10.0.0.0/8 pool from overlapping with the nodes' private IP.
ipam:
  mode: kubernetes
