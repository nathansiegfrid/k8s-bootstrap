namespaceOverride: "{{ cilium_namespace }}"

# Enable host firewall.
# https://docs.cilium.io/en/latest/security/host-firewall/
# https://docs.cilium.io/en/latest/security/policy/host/#hostpolicies
hostFirewall:
  enabled: true

# Enable Gateway API (requires kubeProxyReplacement).
gatewayAPI:
  enabled: true
  # Use host network instead of LoadBalancer service.
  hostNetwork:
    enabled: true

# Allow Gateway API listeners on priviledged port.
# https://docs.cilium.io/en/latest/network/servicemesh/gateway-api/host-network-mode/#bind-to-privileged-port
envoy:
  enabled: true
  securityContext:
    capabilities:
      keepCapNetBindService: true
      envoy:
      # Add NET_BIND_SERVICE to the list (keep the others!)
      - NET_BIND_SERVICE
      - NET_ADMIN
      - SYS_ADMIN
      # Both PERFMON and BPF requires kernel 5.8, container runtime
      # cri-o >= v1.22.0 or containerd >= v1.5.0.
      # If available, SYS_ADMIN can be removed.
      #- PERFMON
      #- BPF

# Enable kube-proxy replacement mode.
kubeProxyReplacement: true
k8sServiceHost: localhost
k8sServicePort: "6443"

# Deploy Cilium Operator on control plane nodes so it can reach localhost:6443.
operator:
  nodeSelector:
    node-role.kubernetes.io/control-plane: "true"

# WIREGUARD

# Specify which network interfaces can run the eBPF datapath.
# Prevents Cilium's device auto-detection from choosing wg0.
# devices: eth0,!wg0

# Enable WireGuard-based transparent encryption for all pod-to-pod traffic.
# Disabled because nodes already communicate over a host-level WireGuard mesh.
# Enabling this would cause redundant double encryption.
# encryption:
#   enabled: true
#   type: wireguard

# Use Kubernetes IPAM to inherits RKE2's pod CIRD (default 10.42.0.0/16).
# This prevents Cilium's default IPAM pool (10.0.0.0/8) from conflicting
# with 10.0.0.0/24 used by the WireGuard mesh.
ipam:
  mode: kubernetes
  # Only required if ipam.mode is set to "cluster-pool":
  # operator:
  #   clusterPoolIPv4PodCIDRList: ["{{ rke2_cluster_cidr | default('10.42.0.0/16') }}"]
