# Enable host firewall.
# https://docs.cilium.io/en/latest/security/host-firewall/
# https://docs.cilium.io/en/latest/security/policy/host/#hostpolicies
hostFirewall:
  enabled: true

# Enable Gateway API (requires kubeProxyReplacement).
gatewayAPI:
  enabled: true

# Enable kube-proxy replacement mode.
kubeProxyReplacement: true
k8sServiceHost: localhost
k8sServicePort: "6443"

# Deploy Cilium Operator on control plane nodes so it can reach localhost:6443.
operator:
  nodeSelector:
    node-role.kubernetes.io/control-plane: "true"

# WIREGUARD

# Specify which network interfaces can run the eBPF datapath.
# Prevents Cilium's device auto-detection from choosing wg0.
devices: "eth0,!wg0"

# Enable WireGuard-based transparent encryption for all pod-to-pod traffic.
encryption:
  enabled: true
  type: wireguard

# Prevent Pod CIDR from overlapping with WireGuard's 10.0.0.0/24 (defaults to 10.0.0.0/8).
ipam:
  operator:
    clusterPoolIPv4PodCIDRList: ["{{ rke2_cluster_cidr }}"]
