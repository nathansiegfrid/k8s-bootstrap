# Deployed by Ansible.
# Do not edit manually, changes will be overwritten.
#
# Docs:
# https://fluxoperator.dev/docs/crd/fluxinstance/
#
# Multi-tenancy example:
# https://github.com/fluxcd/flux2-multi-tenancy#flux-operator-bootstrap

apiVersion: fluxcd.controlplane.io/v1
kind: FluxInstance
metadata:
  name: flux
  namespace: flux-system
spec:
  distribution:
    version: "{{ flux_instance_version }}"
    registry: ghcr.io/fluxcd
  cluster:
    type: kubernetes
    size: medium
    multitenant: true
    tenantDefaultServiceAccount: flux
  sync:
    kind: GitRepository
    url: "{{ flux_gitops_repo_url }}"
    ref: "{{ flux_gitops_ref }}"
    path: "{{ flux_gitops_path }}"
{% if flux_deploy_key | length > 0 %}
    pullSecret: flux-system
{% endif %}
